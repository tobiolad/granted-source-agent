# Copy this file to .env and fill in values for your machine.
# .env is gitignored — never commit real secrets.

# SQLite database file used by Prisma. The default works for local dev.
DATABASE_URL="file:./dev.db"

# Optional. If unset, the app runs entirely in DEMO MODE: all discovery and
# evaluation requests are served from the labeled sample dataset in
# lib/demo-data.ts, and no external API calls are made.
#
# If set, LIVE MODE is enabled: /api/discover and /api/evaluate call the
# Gemini API from the server using this key. The key is never sent to the
# browser and is never requested from end users — see README.md "Security &
# Privacy" for why.
# GEMINI_API_KEY="your-server-side-key"

# Optional. Caps live Gemini calls per IP within the rate-limit window
# (see lib/rate-limit.ts). Defaults to 5 if unset.
# LIVE_DISCOVERY_RATE_LIMIT=5
